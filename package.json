{
  "scripts": {
    "setup": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start:server": "npm run start --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix server && npm run test --prefix client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "lint": "npm run lint --prefix client",
    "lint:fix": "npm run lint --prefix client -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "node scripts/audit.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "ISC",
  "lint-staged": {
    "client/**/*.{js,jsx}": [
      "npm run lint --prefix client",
      "prettier --write"
    ],
    "server/**/*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  }
}
