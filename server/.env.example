PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/collablearn
JWT_SECRET=replace_with_secure_secret
SUPER_ADMIN_EMAILS=shahaadi285@gmail.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional: YouTube Data API v3 key for highest-liked video guidance links
# YOUTUBE_API_KEY=your_youtube_data_api_key

# Optional: add extra fallback models (comma-separated)
# GEMINI_MODEL_CANDIDATES=gemini-1.5-flash,gemini-1.5-pro,gemini-pro

# Optional: shared Redis URL for rate limiting. If unset or unreachable, the
# server falls back to in-memory counters automatically.
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379

# Optional: auth cookie settings for browser sessions.
# AUTH_COOKIE_NAME=collablearn_access_token
# AUTH_COOKIE_PATH=/
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_MAX_AGE_MS=604800000

# Optional: Mongo retry tuning for degraded startup environments.
# DB_CONNECT_MAX_ATTEMPTS=0
# DB_CONNECT_RETRY_BASE_MS=1000
# DB_CONNECT_RETRY_MAX_MS=30000

# Optional: response tuning
# GEMINI_TEMPERATURE=0.7
# GEMINI_TOP_P=0.95
# GEMINI_TOP_K=40
# GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional: global instruction applied to chat + roadmap generations
# GEMINI_SYSTEM_INSTRUCTION=You are a concise learning coach.

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:3000,http://127.0.0.1:3000

# Optional: set when running behind a reverse proxy/load balancer
# TRUST_PROXY=1
